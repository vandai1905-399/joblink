<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Tự động phục vụ file tĩnh nếu có trong thư mục public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(css|js|uploads|modules)/(.*)$ public/$1/$2 [L,QSA]

    # 2. Nếu file hoặc thư mục thật tồn tại thì không rewrite
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Chuyển hướng mọi request còn lại về index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
