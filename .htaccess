DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve static files from public/ when requested from the site root.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(css|js|uploads|modules)/(.*)$ public/$1/$2 [L,QSA]

    # Leave existing files and directories alone.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route the remaining requests to the front controller.
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
